# ==============================================================================
# FIN - Digital Banking Platform
# Environment Configuration Template
# Copy this file to .env and set your own values
# ==============================================================================

# ---- Database (PostgreSQL — for production / Docker Compose) ----
POSTGRES_DB=bankdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DB_PORT=5432

# ---- Spring Boot Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_JWT_SECRET=your_256_bit_hex_secret_here
APP_JWT_EXPIRATION_MS=86400000

# ---- AI Customer Support Chatbot ----
# Providers: 'auto' | 'gemini' | 'openai'
# Falls back to local grounded matcher if no API key is set
AI_PROVIDER=auto

# Google Gemini API (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / Compatible API (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- React Frontend ----
VITE_API_URL=http://localhost:8080/api
FRONTEND_PORT=5173
