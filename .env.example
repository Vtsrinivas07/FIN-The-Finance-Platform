# ==============================================================================
# FIN DIGITAL BANKING PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust credentials as needed
# ==============================================================================

# Database Persistence (PostgreSQL for Docker Compose / Production)
POSTGRES_DB=bankdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# Spring Boot Backend Service
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# AI Customer Support Chatbot Configuration
# Supported providers: 'auto' | 'gemini' | 'openai' (defaults to local grounded matcher if empty)
AI_PROVIDER=auto

# Google Gemini API (Recommended - Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI / Compatible API (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# React Frontend Service
VITE_API_URL=http://localhost:8080/api
FRONTEND_PORT=5173
